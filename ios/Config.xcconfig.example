// Copy to Config.xcconfig and fill in your Supabase project values.
//
// IMPORTANT: In .xcconfig, "//" starts a comment. Write URLs as https:/$()/project.supabase.co
// (the /$()/ becomes "//" in the built app).
SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = your_anon_key_here
